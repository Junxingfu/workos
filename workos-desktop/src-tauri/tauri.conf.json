{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WorkOS",
  "version": "0.2.0",
  "identifier": "com.workos.desktop",
  "build": {
    "beforeBuildCommand": "python3 ../scripts/build-desktop.py",
    "frontendDist": "../bootstrap"
  },
  "app": {
    "windows": [],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'", "capabilities": [] }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "resources": { "resources/": "resources/" },
    "icon": ["icons/icon.png", "icons/icon.icns"],
    "macOS": { "minimumSystemVersion": "12.0", "signingIdentity": "-", "hardenedRuntime": false }
  }
}
